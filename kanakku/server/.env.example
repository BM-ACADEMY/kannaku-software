# ── Server ──
PORT=4000
NODE_ENV=production
APP_URL=https://kanakku.afraventures.in
CORS_ORIGIN=https://kanakku.afraventures.in

# ── Database ──
DATABASE_URL=postgres://kanakku:CHANGE_ME@localhost:5432/kanakku

# ── Secrets for saved keys (Razorpay / WhatsApp / AI / email) and 2-step login ──
# Generate once with: openssl rand -hex 32   — never change it afterwards
INTEGRATIONS_KEY=CHANGE_ME_64_HEX

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=7d

# First admin (created by `npm run db:init` only if no users exist)
ADMIN_NAME=Kamarudeen B
ADMIN_EMAIL=hello@afraventures.in
ADMIN_PASSWORD=CHANGE_ME_STRONG

# ── AI (Grok / x.ai) — optional. Without a key, a built-in rule parser is used. ──
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

# ── Razorpay webhook — optional ──
RAZORPAY_WEBHOOK_SECRET=
# Brand code used when a Razorpay payment has no invoice/brand in its notes
RAZORPAY_DEFAULT_BRAND=HO

# ── n8n / internal automations ──
# n8n sends this in the x-internal-key header when calling /api/internal/*
INTERNAL_API_KEY=CHANGE_ME_RANDOM

# ── Files & autopilot (Docker sets the first two) ──
# UPLOAD_DIR=/app/uploads
# BACKUP_DIR=/backups
# AUTOPILOT=off      # only to stop the daily jobs on this copy of the app
