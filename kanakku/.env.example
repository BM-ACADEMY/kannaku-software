# Used by docker-compose.yml (copy to .env in the project root)
DB_PASSWORD=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME_SAME_AS_server/.env
WA_PHONE_NUMBER_ID=
WA_TOKEN=
# Where the app listens. 127.0.0.1 = only nginx can reach it (server with a domain). 0.0.0.0 = open on the network (local install)
APP_BIND=127.0.0.1
APP_PORT=4000
# false only when running n8n without HTTPS (local install)
N8N_SECURE_COOKIE=true
