{
  "name": "Kanakku · Monday CFO brief (WhatsApp to admins)",
  "nodes": [
    {
      "id": "42663809-240e-4491-91d0-73adade3b5ee",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "3b9356a0-82c1-489e-be20-5b4b7bcb2a46",
      "name": "Get brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "={{ $env.KANAKKU_URL }}/api/internal/weekly-brief",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.KANAKKU_INTERNAL_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6c63761c-7b6a-45f1-b045-24fb590ecb25",
      "name": "Attach text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json;\nreturn b.recipients.map(r => ({ json: { ...r, text: b.text.replace(/\\n+/g, ' | ').slice(0, 1000) } }));"
      }
    },
    {
      "id": "9d257a0f-4e3c-4d37-82c2-376a4485d55d",
      "name": "Send brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KANAKKU_URL }}/api/internal/whatsapp/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.KANAKKU_INTERNAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.phone, type: 'template', template: { name: 'afv_weekly_brief', language: { code: 'en' }, components: [{ type: 'body', parameters: [{ type: 'text', text: String($json.name) }, { type: 'text', text: String($json.text) }] }] } }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Get brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get brief": {
      "main": [
        [
          {
            "node": "Attach text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attach text": {
      "main": [
        [
          {
            "node": "Send brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {}
}