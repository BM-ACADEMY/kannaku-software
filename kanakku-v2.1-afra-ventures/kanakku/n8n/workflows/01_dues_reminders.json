{
  "name": "Kanakku · Daily dues reminders (WhatsApp)",
  "nodes": [
    {
      "id": "3bf4e157-4451-4c67-a636-e9f2fb719eb6",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "018e2a79-da4d-473a-bf9d-547a9c4ffdb0",
      "name": "Get dues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "={{ $env.KANAKKU_URL }}/api/internal/dues-reminders?days=2",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.KANAKKU_INTERNAL_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "019a659b-8644-49e8-a6ed-33c3182cfb5f",
      "name": "One per person",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "rows",
        "options": {}
      }
    },
    {
      "id": "c64adc86-3e80-4da2-8eea-b92f973a84d1",
      "name": "Send reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KANAKKU_URL }}/api/internal/whatsapp/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.KANAKKU_INTERNAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.phone, type: 'template', template: { name: 'afv_payment_reminder', language: { code: 'en' }, components: [{ type: 'body', parameters: [{ type: 'text', text: String($json.party) }, { type: 'text', text: String($json.balance_text) }, { type: 'text', text: String($json.brand_name) }, { type: 'text', text: String($json.number || 'your account') }, { type: 'text', text: String($json.due_date) }] }] } }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "73e1fbef-6cde-41f8-9100-7978a370e74d",
      "name": "Collect due ids",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const all = $('One per person').all().map(i => i.json);\nreturn [{ json: { due_ids: all.filter(r => r.kind === 'due').map(r => r.id), document_ids: all.filter(r => r.kind === 'invoice').map(r => r.id) } }];"
      },
      "executeOnce": true
    },
    {
      "id": "f693e5cf-b2d0-4f17-90f0-a264085b0b09",
      "name": "Mark reminded",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KANAKKU_URL }}/api/internal/dues-reminders/mark",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.KANAKKU_INTERNAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Get dues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get dues": {
      "main": [
        [
          {
            "node": "One per person",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One per person": {
      "main": [
        [
          {
            "node": "Send reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder": {
      "main": [
        [
          {
            "node": "Collect due ids",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect due ids": {
      "main": [
        [
          {
            "node": "Mark reminded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {}
}