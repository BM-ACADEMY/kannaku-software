        "options": {}
      }
    },
    {
      "id": "3a4447e2-e33d-4e37-aa59-c61e2be99080",
      "name": "Has phone?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b40ebf92-c7b2-4478-b225-11e1cb6073dc",
              "leftValue": "={{ $json.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8855d653-4173-4998-a408-8a0ba0bbca1e",
      "name": "Send statement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KANAKKU_URL }}/api/internal/whatsapp/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.KANAKKU_INTERNAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.phone, type: 'template', template: { name: 'afv_investor_statement', language: { code: 'en' }, components: [{ type: 'body', parameters: [{ type: 'text', text: String($json.name) }, { type: 'text', text: String($json.month) }, { type: 'text', text: String(Math.round($json.net_profit).toLocaleString('en-IN')) }, { type: 'text', text: String(Math.round($json.share).toLocaleString('en-IN')) }, { type: 'text', text: String(Math.round($json.accrued_unpaid).toLocaleString('en-IN')) }] }] } }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
