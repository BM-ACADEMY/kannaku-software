diff --git a/kanakku/server/src/lib/ics.js b/kanakku/server/src/lib/ics.js
new file mode 100644
index 0000000..4f9bcdd
--- /dev/null
+++ b/kanakku/server/src/lib/ics.js
@@ -0,0 +1,46 @@
+// Builds an iCalendar (.ics) feed. Google Calendar, Apple Calendar and Outlook can subscribe to the URL
+// ("From URL") and keep it updated by themselves (Google refreshes every few hours).
+const fmtINR = (n) => Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 });
+
+// RFC 5545: escape \ ; , and new lines; fold lines longer than 75 bytes
+const esc = (s) => String(s ?? '').replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
+function fold(line) {
+  const out = []; let cur = ''; let bytes = 0;
+  for (const ch of line) {
+    const b = Buffer.byteLength(ch);
+    if (bytes + b > (out.length ? 74 : 75)) { out.push(cur); cur = ''; bytes = 0; }
+    cur += ch; bytes += b;
+  }
+  out.push(cur);
+  return out.join('\r\n ');
+}
+const ymd = (iso) => iso.replace(/-/g, '');
+const stamp = () => new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z');
+
+// items: [{ key, date, direction, amount, title, party, brand, ref, kind }]
+function buildIcs(items, { name = 'Kanakku · Afra Ventures', domain = 'afraventures.in', appUrl = '' } = {}) {
+  const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Afra Ventures//Kanakku//EN', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
+    `X-WR-CALNAME:${esc(name)}`, 'X-WR-TIMEZONE:Asia/Kolkata', 'REFRESH-INTERVAL;VALUE=DURATION:PT6H', 'X-PUBLISHED-TTL:PT6H'];
+  const now = stamp();
+  for (const i of items) {
+    const next = new Date(new Date(`${i.date}T00:00:00Z`).getTime() + 864e5).toISOString().slice(0, 10);
+    const sign = i.direction === 'out' ? '🔴' : '🟢';
+    const overdue = i.days_left < 0 ? ' (overdue)' : '';
+    lines.push('BEGIN:VEVENT',
+      `UID:${i.key}@kanakku.${domain}`,
+      `DTSTAMP:${now}`,
+      `DTSTART;VALUE=DATE:${ymd(i.date)}`,
+      `DTEND;VALUE=DATE:${ymd(next)}`,
+      `SUMMARY:${esc(`${sign} ${i.title} ₹${fmtINR(i.amount)}${overdue}`)}`,
+      `DESCRIPTION:${esc([`${i.kind}${i.brand ? ` · ${i.brand}` : ''}`, i.ref, `₹${fmtINR(i.amount)} ${i.direction === 'out' ? 'to pay' : 'to receive'}`, appUrl && `Open Kanakku: ${appUrl}`].filter(Boolean).join('\n'))}`,
+      'TRANSP:TRANSPARENT',
+      `CATEGORIES:${i.direction === 'out' ? 'To pay' : 'To collect'}`,
+      // A reminder the day before at 9 am (Apple/Outlook use it; Google uses its own calendar notification settings)
+      'BEGIN:VALARM', 'ACTION:DISPLAY', `DESCRIPTION:${esc(i.title)}`, 'TRIGGER:-PT15H', 'END:VALARM',
+      'END:VEVENT');
+  }
+  lines.push('END:VCALENDAR');
+  return lines.map(fold).join('\r\n') + '\r\n';
+}
+
+module.exports = { buildIcs, esc, fold };
diff --git a/kanakku/server/src/lib/upcoming.js b/kanakku/server/src/lib/upcoming.js
new file mode 100644
index 0000000..931d028
--- /dev/null
+++ b/kanakku/server/src/lib/upcoming.js
@@ -0,0 +1,57 @@
+// Money due in the coming days — used by the "to pay" reminder and the Google Calendar feed.
+//   out: unpaid purchase bills, refunds owed (credit notes), money-to-pay dues, recurring money-out (rent, EMI, salary…)
+//   in:  unpaid invoices, money-to-collect dues, recurring money-in
+const { query } = require('./db');
+const { nextAfter } = require('./recurring');
+const { todayIST } = require('./books');
+
+const addDays = (iso, n) => new Date(new Date(`${iso}T00:00:00Z`).getTime() + n * 864e5).toISOString().slice(0, 10);
+const daysBetween = (a, b) => Math.round((new Date(`${b}T00:00:00Z`) - new Date(`${a}T00:00:00Z`)) / 864e5);
+
+// from/to: YYYY-MM-DD. includeOverdue: also items whose due date is before `from` and still unpaid.
+async function upcoming({ from = todayIST(), to, includeOverdue = true, today = todayIST() } = {}) {
+  to = to || addDays(from, 30);
+  const items = [];
+  const docs = (await query(`SELECT d.id, d.doc_type, d.number, d.vendor_ref, d.due_date, d.doc_date, c.name AS party, b.name AS brand_name,
+      (d.total-d.amount_paid-d.amount_credited) AS bal
+    FROM documents d JOIN customers c ON c.id=d.customer_id JOIN brands b ON b.id=d.brand_id
+    WHERE d.doc_type IN ('invoice','bill','credit_note') AND d.status NOT IN ('cancelled','paid','refunded','issued')
+      AND d.total-d.amount_paid-d.amount_credited > 0.009`)).rows;
+  for (const d of docs) {
+    const date = String(d.due_date || d.doc_date).slice(0, 10);
+    if (date > to || (!includeOverdue && date < from)) continue;
+    const out = d.doc_type !== 'invoice';
+    items.push({ key: `doc-${d.id}`, date, direction: out ? 'out' : 'in', amount: Number(d.bal), party: d.party, brand: d.brand_name,
+      kind: d.doc_type === 'bill' ? 'Bill' : d.doc_type === 'credit_note' ? 'Refund' : 'Invoice',
+      title: `${d.doc_type === 'bill' ? 'Pay bill' : d.doc_type === 'credit_note' ? 'Refund' : 'Collect'} · ${d.party}`,
+      ref: d.number + (d.vendor_ref ? ` (${d.vendor_ref})` : '') });
+  }
+  const dues = (await query(`SELECT d.id, d.direction, d.party, d.note, d.due_date, (d.amount-d.amount_settled) AS bal, b.name AS brand_name
+    FROM dues d JOIN brands b ON b.id=d.brand_id WHERE d.status='open' AND d.document_id IS NULL AND d.due_date IS NOT NULL`)).rows;
+  for (const d of dues) {
+    const date = String(d.due_date).slice(0, 10);
+    if (date > to || (!includeOverdue && date < from)) continue;
+    const out = d.direction === 'payable';
+    items.push({ key: `due-${d.id}`, date, direction: out ? 'out' : 'in', amount: Number(d.bal), party: d.party, brand: d.brand_name, kind: 'Due',
+      title: `${out ? 'Pay' : 'Collect'} · ${d.party}`, ref: d.note || '' });
+  }
+  // Recurring: every coming date in the window (rent, EMI, salaries, subscriptions)
+  const rec = (await query(`SELECT r.*, b.name AS brand_name, c.name AS category_name FROM recurring r
+    LEFT JOIN brands b ON b.id=(r.template->>'brand_id')::int LEFT JOIN categories c ON c.id=(r.template->>'category_id')::int WHERE r.active`)).rows;
+  for (const r of rec) {
+    const t = r.template || {};
+    if (t.type === 'transfer') continue;
+    let d = String(r.next_date).slice(0, 10); let guard = 0;
+    while (d < from && guard++ < 400) d = nextAfter(d, r.frequency, r.day);
+    while (d <= to && guard++ < 400 && (!r.end_date || d <= String(r.end_date).slice(0, 10))) {
+      items.push({ key: `rec-${r.id}-${d}`, date: d, direction: t.type === 'in' ? 'in' : 'out', amount: Number(t.amount), party: t.party || r.name,
+        brand: t.split?.length ? 'Shared' : r.brand_name, kind: r.category_name === 'Loan repaid' ? 'EMI' : 'Recurring',
+        title: `${t.type === 'in' ? 'Expect' : 'Pay'} · ${r.name}`, ref: r.category_name || '' });
+      d = nextAfter(d, r.frequency, r.day);
+    }
+  }
+  for (const i of items) i.days_left = daysBetween(today, i.date);
+  return items.sort((a, b) => a.date.localeCompare(b.date) || b.amount - a.amount);
+}
+
+module.exports = { upcoming, addDays, daysBetween };
diff --git a/kanakku/server/src/routes/calendar.js b/kanakku/server/src/routes/calendar.js
new file mode 100644
index 0000000..d300f16
--- /dev/null
+++ b/kanakku/server/src/routes/calendar.js
@@ -0,0 +1,57 @@
+// Google Calendar feed: a private link (secret token in the URL) that calendar apps subscribe to.
+//   GET  /api/calendar/feed/<token>.ics        — no login (calendar apps can't log in); token is the key
+//   GET  /api/calendar/settings                — admin: the link + what it includes
+//   POST /api/calendar/settings                — admin: turn on/off, choose what to include, make a new link (old one stops)
+const router = require('express').Router();
+const crypto = require('crypto');
+const { z } = require('zod');
+const { query } = require('../lib/db');
+const { ah, parse, HttpError } = require('../lib/http');
+const { requireAuth, requireRole } = require('../middleware/auth');
+const { audit } = require('../lib/audit');
+const { upcoming, addDays } = require('../lib/upcoming');
+const { buildIcs } = require('../lib/ics');
+const { todayIST } = require('../lib/books');
+
+const DEFAULTS = { enabled: false, token: null, include_in: true, days_ahead: 120 };
+async function cfg() { return { ...DEFAULTS, ...((await query("SELECT value FROM settings WHERE key='calendar'")).rows[0]?.value || {}) }; }
+async function save(v) { await query(`INSERT INTO settings (key,value) VALUES ('calendar',$1) ON CONFLICT (key) DO UPDATE SET value=EXCLUDED.value`, [JSON.stringify(v)]); }
+const feedUrl = (req, token) => `${(process.env.APP_URL || `${req.protocol}://${req.get('host')}`).replace(/\/+$/, '')}/api/calendar/feed/${token}.ics`;
+
+router.get('/feed/:file', ah(async (req, res) => {
+  const c = await cfg();
+  const token = String(req.params.file).replace(/\.ics$/, '');
+  const ok = c.enabled && c.token && token.length === c.token.length && crypto.timingSafeEqual(Buffer.from(token), Buffer.from(c.token));
+  if (!ok) throw new HttpError(404, 'Not found');
+  const today = todayIST();
+  let items = await upcoming({ from: addDays(today, -30), to: addDays(today, Number(c.days_ahead) || 120) });
+  if (!c.include_in) items = items.filter((i) => i.direction === 'out');
+  const co = (await query("SELECT value FROM settings WHERE key='company'")).rows[0]?.value || {};
+  res.setHeader('Content-Type', 'text/calendar; charset=utf-8');
+  res.setHeader('Content-Disposition', 'inline; filename="kanakku.ics"');
+  res.setHeader('Cache-Control', 'private, max-age=900');
+  res.end(buildIcs(items, { name: `Kanakku · ${co.short_name || 'Afra Ventures'}`, domain: co.website || 'afraventures.in', appUrl: process.env.APP_URL || '' }));
+}));
+
+router.get('/settings', requireAuth, requireRole('admin'), ah(async (req, res) => {
+  const c = await cfg();
+  res.json({ enabled: c.enabled, include_in: c.include_in, days_ahead: c.days_ahead, url: c.enabled && c.token ? feedUrl(req, c.token) : null });
+}));
+
+router.post('/settings', requireAuth, requireRole('admin'), ah(async (req, res) => {
+  const b = parse(z.object({ enabled: z.boolean(), include_in: z.boolean().default(true), days_ahead: z.coerce.number().int().min(30).max(365).default(120),
+    new_link: z.boolean().default(false) }), req.body);
+  const c = await cfg();
+  const token = b.new_link || !c.token ? crypto.randomBytes(24).toString('hex') : c.token;
+  await save({ enabled: b.enabled, include_in: b.include_in, days_ahead: b.days_ahead, token });
+  await audit(req.user.id, b.new_link ? 'new_calendar_link' : 'update', 'settings', null, { key: 'calendar', enabled: b.enabled });
+  res.json({ enabled: b.enabled, include_in: b.include_in, days_ahead: b.days_ahead, url: b.enabled ? feedUrl(req, token) : null });
+}));
+
+// What's coming (for the Autopilot page list)
+router.get('/upcoming', requireAuth, requireRole('admin', 'accounts'), ah(async (req, res) => {
+  const days = Math.min(120, Math.max(7, Number(req.query.days) || 30));
+  res.json(await upcoming({ to: addDays(todayIST(), days) }));
+}));
+
+module.exports = router;
