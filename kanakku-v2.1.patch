diff --git a/kanakku/web/src/components/Attachments.jsx b/kanakku/web/src/components/Attachments.jsx
new file mode 100644
index 0000000..e37b72f
--- /dev/null
+++ b/kanakku/web/src/components/Attachments.jsx
@@ -0,0 +1,45 @@
+import React, { useRef, useState } from 'react';
+import { api, apiBlobUrl, fileToUpload } from '../lib/api.js';
+import { Err, useApp, useAsync } from './ui.jsx';
+
+// Bill photos / receipts on a Book entry or a document. entity: 'entry' | 'document'
+export default function Attachments({ entity, id, compact }) {
+  const { user, notify } = useApp();
+  const { data, reload } = useAsync(() => (id ? api(`/attachments/${entity}/${id}`) : Promise.resolve([])), [entity, id]);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const input = useRef(null);
+  if (!id) return null;
+
+  const upload = async (files) => {
+    setBusy(true); setError('');
+    try {
+      for (const f of files) {
+        if (f.size > 15 * 1024 * 1024) throw new Error(`${f.name} is too big (max 8 MB after shrinking)`);
+        await api(`/attachments/${entity}/${id}`, { method: 'POST', body: await fileToUpload(f) });
+      }
+      reload(); notify('Attached');
+    } catch (e) { setError(e.message); } finally { setBusy(false); if (input.current) input.current.value = ''; }
+  };
+  const open = async (a) => { try { window.open(await apiBlobUrl(`/attachments/file/${a.id}`), '_blank'); } catch (e) { setError(e.message); } };
+  const remove = async (a) => { if (!window.confirm(`Remove ${a.filename}?`)) return; await api(`/attachments/file/${a.id}`, { method: 'DELETE' }); reload(); };
+
+  return (
+    <div className={`attach${compact ? ' compact' : ''}`}>
+      <div className="row" style={{ gap: 8 }}>
+        <span className="small" style={{ fontWeight: 600 }}>Bill / receipt</span>
+        {(data || []).map((a) => (
+          <span key={a.id} className="attach-chip">
+            <button type="button" className="linkish" onClick={() => open(a)} title={`${Math.round(a.size / 1024)} KB · ${a.uploaded_by || ''}`}>
+              {a.mime === 'application/pdf' ? '📄' : '🖼'} {a.filename.length > 22 ? `${a.filename.slice(0, 20)}…` : a.filename}
+            </button>
+            {user.role === 'admin' && <button type="button" className="x-mini" onClick={() => remove(a)} aria-label="Remove">×</button>}
+          </span>
+        ))}
+        <button type="button" className="btn sm" disabled={busy} onClick={() => input.current?.click()}>{busy ? 'Uploading…' : '+ Add photo / PDF'}</button>
+        <input ref={input} type="file" accept="image/*,application/pdf" capture="environment" multiple hidden onChange={(e) => upload([...e.target.files])} />
+      </div>
+      <Err error={error} />
+    </div>
+  );
+}
diff --git a/kanakku/web/src/components/TwoStep.jsx b/kanakku/web/src/components/TwoStep.jsx
new file mode 100644
index 0000000..104f12b
--- /dev/null
+++ b/kanakku/web/src/components/TwoStep.jsx
@@ -0,0 +1,47 @@
+import React, { useEffect, useState } from 'react';
+import { api } from '../lib/api.js';
+import { Err, Field, Modal, useApp } from './ui.jsx';
+
+// Turn 2-step login on (scan QR → type code) or off (password)
+export default function TwoStep({ enabled, required, onClose, onChanged }) {
+  const { notify } = useApp();
+  const [setup, setSetup] = useState(null);
+  const [code, setCode] = useState('');
+  const [pw, setPw] = useState('');
+  const [error, setError] = useState('');
+  useEffect(() => {
+    if (!enabled) api('/auth/2fa/setup', { method: 'POST' }).then(setSetup).catch((e) => setError(e.message));
+  }, [enabled]);
+  const turnOn = async () => {
+    try { await api('/auth/2fa/enable', { method: 'POST', body: { code } }); notify('2-step login is on'); onChanged(true); } catch (e) { setError(e.message); }
+  };
+  const turnOff = async () => {
+    try { await api('/auth/2fa/disable', { method: 'POST', body: { password: pw } }); notify('2-step login is off'); onChanged(false); } catch (e) { setError(e.message); }
+  };
+  return (
+    <Modal title="2-step login" onClose={required ? () => {} : onClose} footer={enabled
+      ? <><button className="btn" onClick={onClose}>Close</button><button className="btn danger" onClick={turnOff} disabled={!pw}>Turn off</button></>
+      : <>{!required && <button className="btn" onClick={onClose}>Not now</button>}<button className="btn primary" onClick={turnOn} disabled={code.length !== 6}>Turn on</button></>}>
+      <Err error={error} />
+      {required && !enabled && <div className="banner">Admins must use 2-step login (Settings → Books & security). Set it up to continue.</div>}
+      {enabled ? <>
+        <div className="note-box">2-step login is on. After your password, Kanakku asks for the 6-digit code from your authenticator app.</div>
+        <Field label="Your password, to turn it off"><input className="input" type="password" value={pw} onChange={(e) => setPw(e.target.value)} /></Field>
+      </> : setup && <>
+        <ol className="small" style={{ margin: 0, paddingLeft: 18, lineHeight: 1.7 }}>
+          <li>Install <strong>Google Authenticator</strong> or <strong>Microsoft Authenticator</strong> on your phone.</li>
+          <li>Tap <strong>+</strong> → <strong>Scan a QR code</strong> and scan this. (Or "Enter a setup key" and type the key below.)</li>
+          <li>Type the 6-digit code it shows.</li>
+        </ol>
+        <div className="row" style={{ alignItems: 'flex-start' }}>
+          {setup.qr && <img className="qr" src={setup.qr} alt="QR code for your authenticator app" />}
+          <div style={{ flex: 1, minWidth: 200 }}>
+            <div className="small muted">Setup key</div>
+            <div className="code-box">{setup.secret.replace(/(.{4})/g, '$1 ').trim()}</div>
+            <Field label="6-digit code"><input className="input otp-input" inputMode="numeric" maxLength={6} value={code} onChange={(e) => setCode(e.target.value.replace(/\D/g, ''))} autoFocus /></Field>
+          </div>
+        </div>
+      </>}
+    </Modal>
+  );
+}
diff --git a/kanakku/web/src/lib/api.js b/kanakku/web/src/lib/api.js
index 2764855..a5ab0a5 100644
--- a/kanakku/web/src/lib/api.js
+++ b/kanakku/web/src/lib/api.js
@@ -22,7 +22,8 @@ export async function api(path, { method = 'GET', body } = {}) {
     });
     data = await res.json().catch(() => ({}));
   } finally { setBusy(-1); }
-  if (res.status === 401 && path !== '/auth/login') {
+  // Login/forgot/reset answer 401 for a wrong password or code — that's an error to show, not a logout
+  if (res.status === 401 && !path.startsWith('/auth/')) {
     setToken(null);
     window.location.reload();
   }
@@ -37,3 +38,26 @@ export const qs = (o) => {
   const p = Object.entries(o).filter(([, v]) => v !== undefined && v !== null && v !== '');
   return p.length ? `?${new URLSearchParams(p).toString()}` : '';
 };
+
+// Download something that needs the login token (bill photos): returns a temporary object URL
+export async function apiBlobUrl(path) {
+  const res = await fetch(`${API_BASE}/api${path}`, { headers: getToken() ? { authorization: `Bearer ${getToken()}` } : {} });
+  if (!res.ok) throw new Error('Could not open the file');
+  return URL.createObjectURL(await res.blob());
+}
+
+// Read a picked file as base64 (for uploads) — shrinks big phone photos first so uploads stay quick
+export async function fileToUpload(file, maxSide = 1800) {
+  if (file.type.startsWith('image/') && file.type !== 'image/heic' && file.size > 600 * 1024) {
+    try {
+      const bmp = await createImageBitmap(file);
+      const k = Math.min(1, maxSide / Math.max(bmp.width, bmp.height));
+      const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
+      c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
+      const data = c.toDataURL('image/jpeg', 0.82);
+      return { filename: file.name.replace(/\.\w+$/, '') + '.jpg', mime: 'image/jpeg', data };
+    } catch { /* fall back to the original file */ }
+  }
+  const data = await new Promise((ok, bad) => { const r = new FileReader(); r.onload = () => ok(r.result); r.onerror = bad; r.readAsDataURL(file); });
+  return { filename: file.name, mime: file.type || 'application/octet-stream', data };
+}
