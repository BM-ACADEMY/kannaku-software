+      - ./rclone:/config/rclone
+    entrypoint: ["/bin/sh", "-c", "while true; do rclone copy /backups \"$$RCLONE_REMOTE\" --include 'kanakku_*.sql.gz' --include 'uploads_*.tar.gz' --max-age 3d && echo copied; sleep 21600; done"]
+
+volumes:
+  kanakku_uploads:
