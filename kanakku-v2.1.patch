+// GSTIN check: format + the official check digit. Returns { ok, state_code, error }.
+const GSTIN_RE = /^\d{2}[A-Z]{5}\d{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/;
+const CHARS = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
