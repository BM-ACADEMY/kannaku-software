+const adminUrl = base && base.replace(/\/([^/?]+)(\?|$)/, '/postgres$2');
+
+let ok = !!base;
+async function adminQuery(sql) {
+  const { Pool } = require('pg');
+  const p = new Pool({ connectionString: adminUrl });
+  try { await p.query(sql); } finally { await p.end(); }
+}
